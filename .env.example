# Copier ce fichier en .env puis renseigner uniquement les variables nécessaires.
# Ne JAMAIS commiter le fichier .env. Aucune de ces variables n'est obligatoire.

# --- Chemins (facultatif) ---
# VEILLE_DATA_DIR=./data
# VEILLE_CONFIG_DIR=./config

# --- NVD (facultatif) : augmente la limite de débit de l'API NVD (5 -> 50 requêtes / 30 s)
# Demande gratuite : https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# --- Feedly (facultatif) : jeton d'accès API officiel, uniquement si votre offre le permet.
# Ne jamais renseigner de mot de passe. Voir docs/FEEDLY.md
FEEDLY_ACCESS_TOKEN=
# Flux Feedly à lire (ex. user/<id>/category/global.all) ; laissé vide = toutes les catégories
FEEDLY_STREAM_ID=
# Schéma d'authentification : Bearer (défaut) ou OAuth (documentation historique de Feedly)
FEEDLY_AUTH_SCHEME=Bearer

# --- Analyse IA (facultatif, désactivée par défaut) ---
# Activer ensuite l'option dans la page « Automatisation ». Seuls le titre et le résumé public
# des articles sont transmis (jamais l'inventaire ni les secrets).
ANTHROPIC_API_KEY=
# Modèle utilisé (par défaut claude-opus-5-5 ; claude-haiku-5-5 est moins coûteux pour de gros volumes)
VEILLE_AI_MODEL=claude-opus-5-5

# --- Notifications e-mail (facultatif) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_STARTTLS=true

# --- Légifrance via PISTE (facultatif, non implémenté en collecte automatique, voir SOURCES_ET_JUSTIFICATION.md)
# PISTE_CLIENT_ID=
# PISTE_CLIENT_SECRET=
